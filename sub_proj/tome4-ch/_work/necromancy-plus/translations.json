 "Hope\u0001talent name": "希望",
 "#{bold}#%s decays into a pile of ash!#{normal}#\u0001logSeen": "#{bold}#%s化為一堆灰燼！#{normal}#",
 "charnel\u0001talent type": "藏骸",
 "Necromatic power over blood and bone.\u0001_t": "掌控鮮血與白骨的死靈力量。",
