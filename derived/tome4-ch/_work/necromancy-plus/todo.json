 },
 {
  "file": "data/talents/spells/alter-spells.lua",
  "line": 1238,
  "src": "Minions are only tools. You may dispose of them... violently.\nMakes the targeted minion explode for %d%% of its maximum life as blight damage.\nIf used on a Wisp, it will do cold/freeze damage instead.\nIf used on a Bone Giant, it will do physical damage instead and form a temporary shield around you that prevents any attacks from doing more than %d%% of your total life for %d turns.\nBeware! Don't get caught in the blast! (unless you know Dark Empthy: %d%% chance to ignore damage)",
  "tag": "tformat",
  "ctor": "newTalent",
  "prefix": "LOSION.info = function(self, t) return ("
 },
 {
  "file": "data/talents/spells/alter-spells.lua",
  "line": 1300,
  "src": "Combines 3 of your skeletons into a bone giant.\nAt level 1, it makes a bone giant.\nAt level 3, it makes a heavy bone giant.\nAt level 5, it makes an eternal bone giant.\nAt level 7, it makes a runed bone giant.\nOnly one bone giant can be active at any time.",
  "tag": "tformat",
  "ctor": "newTalent",
  "prefix": "SEMBLE.info = function(self, t) return ("
 },
